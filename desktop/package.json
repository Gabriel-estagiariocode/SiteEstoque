{
  "name": "siteestoque",
  "version": "1.0.0",
  "description": "Aplicativo desktop Electron para o VeloStock",
  "author": "VeloStock",
  "main": "electron/main.js",
  "scripts": {
    "start": "node electron/run-electron.js .",
    "dev": "node electron/run-electron.js .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "37.10.3",
    "electron-builder": "26.8.1"
  },
  "build": {
    "appId": "br.com.siteestoque.app",
    "productName": "VeloStock",
    "npmRebuild": false,
    "directories": {
      "output": "../release",
      "buildResources": "../build"
    },
    "files": [
      {
        "from": "..",
        "filter": [
          "api/**/*",
          "assets/**/*",
          "app-config.js",
          "index.html",
          "favicon.ico",
          "favicon.svg",
          "README.md"
        ]
      },
      {
        "from": ".",
        "filter": [
          "electron/**/*",
          "package.json"
        ]
      }
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "win": {
      "target": "nsis",
      "icon": "app-icon.ico",
      "signAndEditExecutable": false,
      "artifactName": "VeloStock-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "VeloStock",
      "runAfterFinish": false
    }
  }
}
